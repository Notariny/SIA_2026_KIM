@page "/login"
@using SIA_2026_KIM.Shared.DModel

<div class="vh-100 d-flex justify-content-center align-items-center container">
	<div class="card w-100 p-4 shadow-sm" style="max-width: 400px; border-radius : 1px;">
		<EditForm Model="_loginModel">
			<DataAnnotationsValidator />

			<div class="mb-3">
				<label class="form-label">Username</label>
				<InputText class="form-control" @bind-Value="_loginModel.UserName" placeholder="Enter username" />
				<ValidationMessage For="() => _loginModel.UserName"/>
			</div>

			<div class="mb-3">
				<label class="form-label">Password</label>
				<InputText class="form-control" @bind-Value="_loginModel.Password" placeholder="Enter password" />
				<ValidationMessage For="() => _loginModel.Password" />
			</div>

			<div class="mb-4 text-center">
				<div class="test-muted small mb-0">
					<button class="btn btn-primary fw-smibold w-100 py-2" type="submit">Login</button>
					<hr />
					<NavLink class="text-decoration-none" href="register">Don't have an account? Register here</NavLink>
				</div>

				
			</div>
		</EditForm>
	</div>
</div>

@code {
	private LoginModel _loginModel = new();
}
