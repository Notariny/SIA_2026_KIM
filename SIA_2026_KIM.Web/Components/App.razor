<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="_content/SIA_2026_KIM.Shared/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="_content/SIA_2026_KIM.Shared/app.css" />
    <link rel="stylesheet" href="SIA_2026_KIM.Web.styles.css" />
    <ImportMap />
    <link rel="icon" type="image/png" href="_content/SIA_2026_KIM.Shared/favicon.png" />
    <HeadOutlet @rendermode="DynamicRenderMode" />
</head>

<body>
    <Routes @rendermode="DynamicRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

@code{
    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    public IComponentRenderMode? DynamicRenderMode => 
        HttpContext!.AcceptsInteractiveRouting() ? InteractiveServer : null;
}

</html>
